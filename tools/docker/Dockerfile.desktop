# The Linux desktop build and its run environment in Docker (teton-dev fork), for building and playing HeartGold
# and SoulSilver on a Mac: the same compiler and packages as .github/workflows/build_port.yml (Ubuntu 24.04, gcc 13),
# plus a virtual display, VNC, screenshots and scripted input. Used by tools/docker/desktop.sh.
FROM ubuntu:24.04

RUN apt-get update && apt-get install -y --no-install-recommends \
    git ca-certificates python3 python3-pip gcc g++ ninja-build nasm flex bison pkg-config libsdl2-dev libenet-dev \
    xvfb x11vnc xdotool imagemagick x11-utils binutils \
    libgl1 libgl1-mesa-dri libglx-mesa0 libegl1 libegl-mesa0 libgles2 \
    && pip install --break-system-packages 'meson>=1.3' \
    && rm -rf /var/lib/apt/lists/*
