+    if(inColorAdjust != vec3(0.0)) {
+        float luma = dot(color.rgb, vec3(0.299, 0.587, 0.114));
+        // Vibrance: saturation that favours the dull colours (the more saturated a colour is, the less it changes)
+        float chroma = max(color.r, max(color.g, color.b)) - min(color.r, min(color.g, color.b));
+        float sat = 1.0 + inColorAdjust.x * 0.5 + inColorAdjust.y * 0.5 * (1.0 - chroma);
+        color.rgb = clamp(vec3(luma) + (color.rgb - vec3(luma)) * sat, 0.0, 1.0);
+        // Contrast around mid grey
+        color.rgb = clamp((color.rgb - 0.5) * (1.0 + inColorAdjust.z * 0.5) + 0.5, 0.0, 1.0);
+    }
