[wrap-git]
# teton-dev fork: SilasMayes/libntr's thor-android (90c1775) plus the left stick as a second D-pad
# (Settings > Controls > Left stick as D-pad), the commit the Platinum fork (teton-dev/pokeplatinum-thor-ls) pins.
# The patches are the Platinum fork's (its libntr.wrap says what each one does): the renderer's fixes (clipping in
# clip space, perspective-correct interpolation, the W-buffer, translucent polygons' state and IDs, the 3D buffer's
# clear, texture bank D, BG character bases), the sound lock (a crash in the sequencer) and NitroSystem's wave output,
# and the widescreen calls the game can make (OBJ wrap and edges, BG edges, mirror, stripes, windows, the sub engine
# on top, sprite depth bias). Keep them the same as the Platinum fork's.
url = https://github.com/teton-dev/libntr.git
revision = 578c6a8c6e8904aac233d34b8d084e0639f478f1
depth = 1
directory = libntr
diff_files = libntr_g3_mult.patch, libntr_g3_clip.patch, libntr_g3_clear.patch, libntr_wide_obj.patch, libntr_snd_waveout.patch, libntr_g3_translucent_state.patch, libntr_wide_edge.patch, libntr_translucent_id.patch, libntr_g3_perspective.patch, libntr_wide_obj_edge.patch, libntr_wide_window.patch, libntr_bg_charbase.patch, libntr_wide_mirror.patch, libntr_wide_subtop.patch, libntr_tex_bank_d.patch, libntr_wide_stripe.patch, libntr_sprite_depth.patch, libntr_snd_lock.patch, libntr_g3_tex_wrap.patch

[provide]
dependency_names = NitroSDK
program_names = makelcf
