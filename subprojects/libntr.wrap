[wrap-git]
# teton-dev fork: SilasMayes/libntr's thor-android (90c1775) plus the left stick as a second D-pad
# (Settings > Controls > Left stick as D-pad), the commit the Platinum fork (teton-dev/pokeplatinum-thor-ls) pins.
# The patches are the Platinum fork's (its libntr.wrap says what each one does): the renderer's fixes (clipping in
# clip space, perspective-correct interpolation, the W-buffer, translucent polygons' state and IDs, the 3D buffer's
# clear, texture bank D, BG character bases), the sound lock (a crash in the sequencer) and NitroSystem's wave output,
# and the widescreen calls the game can make (OBJ wrap and edges, BG edges, mirror, stripes, windows, the sub engine
# on top, sprite depth bias). Keep them the same as the Platinum fork's.
url = https://github.com/teton-dev/libntr.git
revision = 5068cdaacc7b5dfb6ab53030fae2f4b0b1a82e94
depth = 1
directory = libntr
# libntr_native_menus.patch: the settings in the platform's own UI (Android's views, NativeSettings.java): SIM::UI's
# widgets record themselves as JSON instead of drawing, and answer the events that UI sends back; Link play's page
# goes beside the game's connections (order 68)
# libntr_carts_known.patch: "Add a game" applies xdelta 1.1 patches too (Sacred Gold, Storm Silver), warns about ROMs
# and patches the game doesn't know (SIM_Prj_KnownRom, SIM_Prj_KnownPatch, SIM_Prj_CartWarning), and takes its words
# about the game's hacks from the game (SIM_Prj_AddGameText)
# libntr_wide_edge_bg0.patch: BG0 drawn as 2D gets the wide scene's edge extension too (layers 1 to 3 had it; the
# Bug-Catching Contest's swap screen has its top picture on the sub engine's BG0)
# libntr_battle_speed.patch: Settings > Controls > Battle speed (1.5x, 2x, 3x, 4x): while the game says a battle is running
# (SIM_SetBattleActive) it runs at that speed, in place of fast-forward's
# libntr_color_adjust.patch: Settings > Display > Color Balance (sliders: saturation, vibrance, contrast, white point, -25..+25,
# applied to each screen before the fade; SIM::UI::Slider), and the defaults Widescreen on and Fast forward as a toggle
# libntr_native_menus_carts.patch: the carts UI over the settings: the native view steps aside (SuspendNative)
# libntr_native_screens.patch: the carts UI (Add a game, the game picker, a version question) as native views too
# libntr_test_shot.patch: SIM_TestShotRequest, a test script's screenshot written by libntr from the frame it presents (the
# window's picture read by another program lagged what was shown: black shots of drawn frames, 2026-11-26)
diff_files = libntr_g3_mult.patch, libntr_g3_clip.patch, libntr_g3_clear.patch, libntr_wide_obj.patch, libntr_snd_waveout.patch, libntr_g3_translucent_state.patch, libntr_wide_edge.patch, libntr_translucent_id.patch, libntr_g3_perspective.patch, libntr_wide_obj_edge.patch, libntr_wide_window.patch, libntr_bg_charbase.patch, libntr_wide_mirror.patch, libntr_wide_subtop.patch, libntr_tex_bank_d.patch, libntr_wide_stripe.patch, libntr_sprite_depth.patch, libntr_snd_lock.patch, libntr_g3_tex_wrap.patch, libntr_wide_subtop_bgs.patch, libntr_3d_premultiplied.patch, libntr_native_menus.patch, libntr_native_menus_carts.patch, libntr_carts_known.patch, libntr_wide_edge_bg0.patch, libntr_battle_speed.patch, libntr_color_adjust.patch, libntr_native_screens.patch, libntr_second_swap_after.patch, libntr_android_pacing.patch, libntr_enhanced_grade.patch, libntr_enhanced_shadows.patch, libntr_enhanced_water.patch, libntr_enhanced_shadow_grid.patch, libntr_enhanced_sun_shadows_3d.patch, libntr_enhanced_highlights.patch, libntr_enhanced_atmosphere.patch, libntr_enhanced_shadow_res.patch, libntr_enhanced_shadow_map.patch, libntr_android_main_async.patch, libntr_enhanced_jubilife.patch, libntr_android_watchdog_status.patch, libntr_enhanced_water_mirror.patch, libntr_win64_build.patch, libntr_enhanced_shadow_stable.patch, libntr_test_missing_file.patch, libntr_win64_stdio.patch, libntr_test_shot.patch

[provide]
dependency_names = NitroSDK
program_names = makelcf
